{
  "name": "acta-pro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:smoke": "vitest run --config vitest.smoke.config.mts",
    "check:env": "tsx scripts/check-env.ts",
    "test:security": "node scripts/verify-security.mjs",
    "verify:security": "npm run typecheck && npm run lint && npm run test && npm run test:security && npm run test:concurrency && npm run test:integration",
    "test:concurrency": "node scripts/verify-concurrency.mjs",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "verify:clean-install": "node scripts/verify-clean-install.mjs",
    "verify:restore": "node scripts/verify-restore.mjs",
    "verify:remote": "vitest run --config vitest.remote.config.mts",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "test:e2e:local": "playwright test --config playwright.local.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@deepgram/sdk": "^5.8.0",
    "@react-pdf/renderer": "^4.6.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "clsx": "^2.1.1",
    "googleapis": "190.0.0",
    "next": "16.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.20.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.12",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "supabase": "3.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
