# ACTA PRO — variables de entorno
# Copie este archivo como .env.local y complete los valores.
# Nunca escriba claves reales en este archivo ni las suba al repositorio.

# --- Supabase (indispensable con DEMO_MODE=false) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Deepgram: transcripción y diarización (indispensable con DEMO_MODE=false) ---
DEEPGRAM_API_KEY=
NEXT_PUBLIC_DEEPGRAM_MODEL=nova-3
NEXT_PUBLIC_DEEPGRAM_LANGUAGE=es-419
# Use únicamente diarize_model. El parámetro diarize=true está deprecado.
DEEPGRAM_DIARIZE_MODEL=latest
DEEPGRAM_TOKEN_TTL_SECONDS=3600
DEEPGRAM_MIP_OPT_OUT=true

# --- Anthropic: borrador del acta (indispensable con DEMO_MODE=false) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Resend: envío del acta (opcional) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Google Calendar: importación de reuniones (opcional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
GOOGLE_CALENDAR_ID=primary
# 32 bytes aleatorios en Base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# --- Runachay: sin API oficial. El conector permanece simulado. ---
RUNACHAY_BASE_URL=
RUNACHAY_API_KEY=

# --- Modo de ejecución ---
# true: la aplicación arranca sin claves y rotula toda simulación en la interfaz.
DEMO_MODE=true
# El audio nunca se guarda en el servidor. Estas banderas solo controlan si el
# navegador conserva su copia local para reintentar la transcripción.
DEMO_KEEP_AUDIO=false
KEEP_AUDIO_AFTER_TRANSCRIPTION=false
NEXT_PUBLIC_APP_URL=http://localhost:3000
